# Web admin sign-in (leave the password empty to disable it)
SP_ADMIN_USER=admin
SP_ADMIN_PASSWORD=

# Extra certificate hostnames, comma separated
# SP_HOSTNAMES=localhost,127.0.0.1,::1,scratchpads.orb.local,scratchpads

# Cloudflare tunnel (docker compose --profile cloudflare up -d)
# TUNNEL_TOKEN=
# SP_TRUST_CLOUDFLARE=1

# Real certificate from Let's Encrypt for a public hostname (443 must reach the container)
# SP_ACME_DOMAINS=pads.example.com
# SP_ACME_EMAIL=you@example.com
